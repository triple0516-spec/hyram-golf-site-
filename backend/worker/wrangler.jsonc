{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyram-golf-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "d1_databases": [{"binding": "DB", "database_name": "hyram-golf-identity"}],
  "ratelimits": [{"name": "RATE_LIMIT", "namespace_id": "1001", "simple": {"limit": 10,"period":60}}]
}